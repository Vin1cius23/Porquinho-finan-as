# Chave da API da Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-sua-chave-aqui
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Conexão com o Banco de Dados Supabase (PostgreSQL)
# Copie no painel do Supabase clicando no botão "Connect" (topo) -> URI
DATABASE_URL=postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA-AQUI]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[SEU-PROJETO].supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-ou-publishable-aqui

# Segredo para assinatura dos tokens JWT de autenticação
JWT_SECRET=troque-este-segredo-em-producao-finchat-2026

# Porta do servidor e fuso horário padrão
PORT=3000
TZ=America/Sao_Paulo
